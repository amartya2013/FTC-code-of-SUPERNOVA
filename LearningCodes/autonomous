package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.util.ElapsedTime;

@Autonomous
public class shootFirstAutonomous extends OpMode {
    private final double robotPosition1 = 76.3;//robots first move
    private final double robotPosition2 = 1016;//robots second move
    private final double robotPosition3 = 2032;//robots third move
    //makes a variable for all motors and servosw
    private DcMotor leftMotor;
    private DcMotor rightMotor;
    private DcMotor flyWheel;
    private CRServo windmill;
    //all the other variables needed for the math.(got this from Biobuzz example code)
    final double DRIVE_SPEED = 0.5;
    final double ROTATE_SPEED = 0.2;
    final double WHEEL_DIAMETER_MM = 96;
    final double ENCODER_TICKS_PER_REV = 537.7;
    final double TICKS_PER_MM = (ENCODER_TICKS_PER_REV / (WHEEL_DIAMETER_MM * Math.PI));
    final double TRACK_WIDTH_MM = 402;
    final double LAUNCHER_TARGET_VELOCITY =1250;
    final double LAUNCHER_MIN_VELOCITY = 1200;
    //sets a timer for the windmill
    private ElapsedTime windmillTimer = new ElapsedTime();
    @Override
    public void init (){
        //sets the direction and makes the motors a variable
      leftMotor = hardwareMap.get(DcMotor.class, "leftMotor");
      leftMotor.setDirection(DcMotorSimple.Direction.REVERSE);
      rightMotor = hardwareMap.get(DcMotor.class, "rightMotor");
      rightMotor.setDirection(DcMotorSimple.Direction.FORWARD);
      flyWheel = hardwareMap.get(DcMotor.class, "flyWheel");
      flyWheel.setDirection(DcMotorSimple.Direction.FORWARD);
      windmill = hardwareMap.get(CRServo.class, "windmill");
      leftMotor.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
      rightMotor.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
      leftMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
      rightMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
    }

    @Override
    public void start (){
        //moves certain distance
        int targetTicks1 = (int) (robotPosition1*TICKS_PER_MM);
        rightMotor.setTargetPosition(targetTicks1);
        leftMotor.setTargetPosition(targetTicks1);
        rightMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightMotor.setPower(0.4);
        leftMotor.setPower(0.4);
        //shoots pollen
        int spinTicks = (int) (LAUNCHER_TARGET_VELOCITY*7);
        flyWheel.setTargetPosition(spinTicks);
        int windSpin = (int) (0.7*7);
        windmillTimer.reset();
        //turns left 90 degrees
        double turnDistanceMM1 = (TRACK_WIDTH_MM * Math.PI) / 4.0;
        int turnTicks1 = (int) (turnDistanceMM1 * TICKS_PER_MM);
        leftMotor.setTargetPosition(-turnTicks1);
        rightMotor.setTargetPosition(turnTicks1);
        leftMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftMotor.setPower(0.3);
        rightMotor.setPower(0.3);
        //moves forward a certain distance
        int targetTicks2 = (int) (robotPosition2*TICKS_PER_MM);
        rightMotor.setTargetPosition(targetTicks2);
        leftMotor.setTargetPosition(targetTicks2);
        rightMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightMotor.setPower(0.3);
        leftMotor.setPower(0.3);
        //turns right
        double turnDistanceMM2 = (TRACK_WIDTH_MM * Math.PI) / 4.0;
        int turnTicks2 = (int) (turnDistanceMM2 * TICKS_PER_MM);
        leftMotor.setTargetPosition(turnTicks2);
        rightMotor.setTargetPosition(-turnTicks2);
        leftMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftMotor.setPower(0.3);
        rightMotor.setPower(0.3);
        //moves forward into parking zone
        int targetTicks3 = (int) (robotPosition3*TICKS_PER_MM);
        rightMotor.setTargetPosition(targetTicks3);
        leftMotor.setTargetPosition(targetTicks3);
        rightMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        leftMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        rightMotor.setPower(0.3);
        leftMotor.setPower(0.3);





    }
    @Override
    public void loop (){
        //basically stops motors and resets timers
        if (!leftMotor.isBusy()&& !rightMotor.isBusy())
            leftMotor.setPower(0.0);
        rightMotor.setPower(0.0);
        if (windmillTimer.seconds() < 7.0) {
            windmill.setPower(1.0); // Use -1.0 if it spins backwards
            telemetry.addData("Windmill Status", "Spinning");
        } else {
            windmill.setPower(0.0);
            telemetry.addData("Windmill Status", "Stopped");
        }

        telemetry.addData("Timer", "%.2f seconds", windmillTimer.seconds());
    }
}
